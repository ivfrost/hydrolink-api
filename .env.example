# .env.example
# Copy this file to .env and fill in real values before running the app locally.
#   cp .env.example .env
#
# The app loads .env through spring.config.import (see application.properties).
# Every value below is required and has no default anywhere, so a missing value
# fails fast at startup.

# --- Device secrets ---
# Generate each with: openssl rand -base64 32
DEVICE_KEY_SECRET=
DEVICE_PROVISIONING_SECRET=

# --- OAuth2 Cognito ---
# Pool and app client the API validates tokens against. The issuer URI is built
# from these in application-<profile>.properties.
AWS_USER_POOL_ID=
AWS_USER_POOL_CLIENT_ID=
AWS_REGION=

# --- Database ---
# Must match docker-compose.yml's postgres service: these values create the
# Postgres role/database on first container init AND are what the app connects
# with, so they must be identical on both sides.
DB_URL=jdbc:postgresql://localhost:5432/hydrodb-dev
DB_USERNAME=admin
DB_PASSWORD=
DB_NAME=hydrodb-dev

# --- Seed Data ---
# Dev seeding creates the Cognito admin user and binds the local row to its sub.
# Generate secrets with: openssl rand -hex 16
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEVICE1_KEY=
SEED_DEVICE1_SECRET=
SEED_DEVICE2_KEY=
SEED_DEVICE2_SECRET=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO ---
MINIO_URL=http://localhost:9000
MINIO_EXT_URL=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_DEFAULT_BUCKETS=

# --- Device status queue (SQS) ---
# Name of the queue the IoT rule writes device status into. The dev profile
# reads it with the static keys below; stage and prod resolve credentials from
# the deployment role instead.
DEVICE_STATUS_QUEUE=

# --- AWS (dev credentials) ---
# Only used by the dev profile (and test), to read the device-status SQS queue
# and call Cognito's admin API locally. Needs sqs:ReceiveMessage,
# sqs:DeleteMessage on the queue plus cognito-idp:AdminGetUser, AdminCreateUser,
# AdminSetUserPassword, and AdminUpdateUserAttributes. Stage and prod resolve
# credentials from the deployment role and never read these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- OpenAPI docs ---
# Toggle the Swagger UI / OpenAPI specs per environment.
SPRINGDOC_API_DOCS_ENABLED=
SPRINGDOC_SWAGGER_UI_ENABLED=
