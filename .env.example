# .env.example
# Copy this file to .env and fill in real values before running the app locally.
#   cp .env.example .env
#
# No defaults are set anywhere (Spring properties or docker-compose) — every
# variable below is required. Missing any of them will cause a fail-fast error
# at startup (Spring) or docker compose refusing to start the service.

# --- User secrets ---
# Generate each with: openssl rand -base64 32
USER_JWT_SECRET=
USER_RECOVERY_SECRET=

# --- Device secrets ---
DEVICE_KEY_SECRET=
DEVICE_PROVISIONING_SECRET=

# --- Auth (JWT) ---
USER_TOKEN_ISSUER=hydro-api
USER_ACCESS_TOKEN_EXPIRATION=900000
USER_REFRESH_TOKEN_EXPIRATION=2592000000

# --- Database ---
# Must match docker-compose.dev.yml's postgres service — these values create
# the Postgres role/database on first container init AND are what the app
# connects with, so they must be identical on both sides.
DB_URL=jdbc:postgresql://localhost:5432/hydrodb-dev
DB_USERNAME=admin
DB_PASSWORD=
DB_NAME=hydrodb-dev

# --- Seed Data ---
# Generate secrets with: openssl rand -hex 16
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEVICE1_KEY=
SEED_DEVICE1_SECRET=
SEED_DEVICE2_KEY=
SEED_DEVICE2_SECRET=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Minio ---
MINIO_URL=http://localhost:9000
MINIO_EXT_URL=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_DEFAULT_BUCKETS=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- AWS (dev SQS credentials) ---
# Only used by the dev profile to READ the device-status SQS queue locally.
# Create a dedicated IAM *user* (e.g. hydrolink-api-dev) with an inline policy
# allowing sqs:ReceiveMessage + sqs:DeleteMessage on the queue, then use its
# key id/secret here. Do NOT reuse the IoT-rule role hydrolink-rule-status-send-sqs;
# that one is WRITE-only and assumed by AWS IoT, not by this app.
# Referenced from application-dev.properties. Prod/stage use an IAM task role
# (no keys) and never read these. Never commit real values — .env is gitignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=